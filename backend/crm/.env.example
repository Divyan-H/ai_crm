# ── Supabase (Project Settings → API) ─────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — backend only, never expose it to the browser
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Groq (console.groq.com) ───────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ── Redis / Celery ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# true = run tasks in-process without a broker (local experiments only)
CELERY_TASK_ALWAYS_EAGER=false

# ── Inter-service ─────────────────────────────────────────────────────
CHANNEL_SERVICE_URL=http://localhost:8001
# Public URL of this API — used in email open/click/unsubscribe links
PUBLIC_BASE_URL=http://localhost:8000

# ── App ───────────────────────────────────────────────────────────────
PORT=8000
DEBUG=false
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000
